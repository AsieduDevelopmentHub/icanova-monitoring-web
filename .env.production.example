# Production SPA build template — copy to .env.production.local (gitignored).
# Never commit real values. Never put secrets in VITE_*.
#
# Status: OPERATOR CONFIGURATION REQUIRED
# Block Convex prod AUTH_*/INGEST_SECRET until Auth0 + hosting domain are set.
# See docs/guide/production-auth0-and-hosting.md

# --- Convex (public cloud URL only) ---
# Confirm deployment identity before filling (proposed: tremendous-sturgeon-449).
VITE_CONVEX_URL=https://tremendous-sturgeon-449.convex.cloud
# Optional convenience (not required by Vite):
# VITE_CONVEX_SITE_URL=https://tremendous-sturgeon-449.convex.site

# --- Auth0 production (separate tenant from staging) ---
# Staging host MUST NOT appear here (dev-notfczud6xx8hhxf.us.auth0.com).
VITE_OIDC_ISSUER=https://<prod-tenant>.<region>.auth0.com/
VITE_OIDC_CLIENT_ID=
VITE_OIDC_AUDIENCE=icanova
# Cloudflare Pages example (replace if custom domain is attached):
# VITE_OIDC_REDIRECT_URI=https://icanova.pages.dev/auth/callback
# VITE_OIDC_LOGOUT_REDIRECT_URI=https://icanova.pages.dev/
VITE_OIDC_REDIRECT_URI=https://<production-domain>/auth/callback
VITE_OIDC_LOGOUT_REDIRECT_URI=https://<production-domain>/
# Optional Auth0 Universal Logout:
# VITE_OIDC_END_SESSION_ENDPOINT=https://<prod-tenant>.<region>.auth0.com/v2/logout

# Optional observability (public DSNs only)
# VITE_SENTRY_DSN=
# VITE_GA_MEASUREMENT_ID=

# --- Convex CLI deploy (server) — NOT for Vite; keep in vault / deploy key file ---
# CONVEX_DEPLOYMENT=prod:tremendous-sturgeon-449
# CONVEX_DEPLOY_KEY=   # never commit
