# =============================================================================
# Frontend (Vite) — copy to .env.local. Only VITE_* values belong here.
# Leave blank to keep the local gateway UI usable without that service.
# =============================================================================

# ESP32 gateway the dev server proxies /api to (local / soft-AP only).
VITE_GW_URL=http://192.168.4.1

# Convex deployment URL from `pnpm convex:dev` (https://....convex.cloud).
VITE_CONVEX_URL=

# Sentry React DSN. Omit to disable error reporting.
VITE_SENTRY_DSN=

# GA4 measurement ID (G-XXXXXXXX). Omit to disable. Not loaded in mock mode.
VITE_GA_MEASUREMENT_ID=

# Active login is Convex Auth (email+password) — no VITE_OIDC_* required.
# Auth0 OIDC vars are future enterprise IdP only (src/auth/integrations/auth0/).
# VITE_OIDC_ISSUER=
# VITE_OIDC_CLIENT_ID=
# VITE_OIDC_AUDIENCE=icanova
# VITE_OIDC_REDIRECT_URI=
# VITE_OIDC_LOGOUT_REDIRECT_URI=
# See docs/status/phase-8.5e-convex-auth-transition.md

# =============================================================================
# Convex server env — set with: pnpm exec convex env set NAME value
# Never put these in VITE_ variables. Never commit real values.
# Full inventory: docs/guide/env-inventory.md
# =============================================================================
#
# --- Convex Auth (active) ---
# Generate with the Convex Auth key script (JWT_PRIVATE_KEY + JWKS).
# JWT_PRIVATE_KEY=
# JWKS=
# Required for password-reset / email verification redirects (SPA origin):
# SITE_URL=https://icanova.pages.dev
# Public self-signup (Password signUp). Unset or 1 = enabled; 0/false = disabled.
# AUTH_SIGNUP_ENABLED=1
# Do not set these on production (sturgeon) without written authorization.
#
# --- Password reset email (Convex Auth Password reset OTP) ---
# Prefer AUTH_RESEND_KEY; otherwise RESEND_API_KEY is reused.
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM=iCaNova Monitoring <alerts@example.com>
# AUTH_PASSWORD_RESET_DEV=1   # staging/dev only: allow reset without Resend (no token logged)
#
# --- Auth0 customJwt (future only; not loaded by auth.config.ts) ---
# AUTH_JWT_ISSUER=
# AUTH_JWKS_URL=
# AUTH_JWT_AUDIENCE=icanova
# AUTH_JWT_JWKS=
#
# --- Ingestion ---
# INGEST_SECRET=
# Collector: Authorization: Bearer $INGEST_SECRET → https://<deployment>.convex.site/ncu/ingest
# Shared secret is required for current ESP32/NCU1 deployments. See docs/status/phase7-production-readiness.md
# for rotation strategy. Do not put device-specific credentials in VITE_.
#
# Optional server-side rate limits (defaults: 60/device/min, 600/IP/min, 60000 ms window):
# INGEST_RATE_LIMIT_DEVICE=60
# INGEST_RATE_LIMIT_IP=600
# INGEST_RATE_WINDOW_MS=60000
#
# --- Email (optional) ---
# RESEND_API_KEY=
# RESEND_FROM=iCaNova Monitoring <alerts@your-verified-domain.com>
#
# --- SMS (optional) ---
# ARKESEL_API_KEY=
# ARKESEL_SENDER=DSE
#
# Without Resend/Arkesel, email/SMS attempts stay not_configured.
#
# --- Browser Web Push (VAPID, no FCM) — Convex server env only ---
# Generate keys: pnpm exec web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@your-domain.com
# Never put VAPID_PRIVATE_KEY in a VITE_ variable or client bundle.
# Without these, push outbox rows stay not_configured; in-app/email/SMS still work.
#
# --- Staging / lab notify overrides (never production customer destinations) ---
# TEST_NOTIFY_EMAIL=
# TEST_NOTIFY_PHONE=
#
# --- Collector (firmware tools/.env, not Vite) ---
# NCU_KEY=                        # 32 hex characters
# INGEST_URL=https://<deployment>.convex.site/ncu/ingest
# INGEST_SECRET=                  # same as Convex
