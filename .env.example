# =============================================================================
# Frontend (Vite) — copy to .env.local. Only VITE_* values belong here.
# Leave blank to keep the local gateway UI usable without that service.
# =============================================================================

# ESP32 gateway the dev server proxies /api to (local / soft-AP only).
VITE_GW_URL=http://192.168.4.1

# Convex deployment URL from `pnpm convex:dev` (https://....convex.cloud).
VITE_CONVEX_URL=

# Sentry React DSN. Omit to disable error reporting.
VITE_SENTRY_DSN=

# GA4 measurement ID (G-XXXXXXXX). Omit to disable. Not loaded in mock mode.
VITE_GA_MEASUREMENT_ID=

# Optional public OIDC SPA settings (PKCE). Never put a client secret here.
# Leave blank to keep bearer injection / Clear session only.
# VITE_OIDC_ISSUER=https://YOUR_TENANT.example/
# VITE_OIDC_CLIENT_ID=
# VITE_OIDC_AUDIENCE=dse-gateway
# VITE_OIDC_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
# VITE_OIDC_LOGOUT_REDIRECT_URI=http://127.0.0.1:5173/
# VITE_OIDC_AUTHORIZATION_ENDPOINT=
# VITE_OIDC_TOKEN_ENDPOINT=
# VITE_OIDC_END_SESSION_ENDPOINT=

# =============================================================================
# Convex server env — set with: pnpm exec convex env set NAME value
# Never put these in VITE_ variables. Never commit real values.
# Full inventory: docs/env-inventory.md
# =============================================================================
#
# --- Authentication (production needs real issuer + JWKS; do not invent) ---
# AUTH_JWT_ISSUER=disabled
# AUTH_JWKS_URL=disabled
# AUTH_JWT_AUDIENCE=dse-gateway
# AUTH_JWT_JWKS=
# Use disabled until a real RS256 issuer exists.
# A non-empty https issuer and JWKS URL turn providers on.
# AUTH_JWT_JWKS is the public JWK set only (for /.well-known/jwks.json).
# Keep the private signing key out of this repo and out of VITE_ vars.
#
# --- Ingestion ---
# INGEST_SECRET=
# Collector: Authorization: Bearer $INGEST_SECRET → https://<deployment>.convex.site/ncu/ingest
# Shared secret is required for current ESP32/NCU1 deployments. See docs/phase7-production-readiness.md
# for rotation strategy. Do not put device-specific credentials in VITE_.
#
# Optional server-side rate limits (defaults: 60/device/min, 600/IP/min, 60000 ms window):
# INGEST_RATE_LIMIT_DEVICE=60
# INGEST_RATE_LIMIT_IP=600
# INGEST_RATE_WINDOW_MS=60000
#
# --- Email (optional) ---
# RESEND_API_KEY=
# RESEND_FROM=DSE Gateway <alerts@your-domain.com>
#
# --- SMS (optional) ---
# ARKESEL_API_KEY=
# ARKESEL_SENDER=DSE
#
# Without Resend/Arkesel, email/SMS attempts stay not_configured.
# Web push is not implemented. Do not put a VAPID private key in a VITE_ variable.
#
# --- Staging / lab notify overrides (never production customer destinations) ---
# TEST_NOTIFY_EMAIL=
# TEST_NOTIFY_PHONE=
#
# --- Collector (firmware tools/.env, not Vite) ---
# NCU_KEY=                        # 32 hex characters
# INGEST_URL=https://<deployment>.convex.site/ncu/ingest
# INGEST_SECRET=                  # same as Convex
