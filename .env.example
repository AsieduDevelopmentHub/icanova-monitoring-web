# Vite (browser). Copy to .env.local. Leave blank to keep the gateway UI running
# without that service.

# ESP32 gateway the dev server proxies /api to.
VITE_GW_URL=http://192.168.4.1

# Convex deployment URL from `pnpm convex:dev` (looks like https://....convex.cloud).
VITE_CONVEX_URL=

# Sentry React DSN. Omit to disable error reporting.
VITE_SENTRY_DSN=

# GA4 measurement ID (G-XXXXXXXX). Omit to disable analytics. Not loaded in mock mode.
VITE_GA_MEASUREMENT_ID=

# Convex dashboard env (`pnpm exec convex env set NAME value`). Never put these in VITE_ vars.
# AUTH_JWT_ISSUER=disabled
# AUTH_JWKS_URL=disabled
# AUTH_JWT_AUDIENCE=dse-gateway
# Use disabled until a real RS256 issuer exists. A non-empty https issuer and JWKS URL turn providers on.
# RESEND_API_KEY=
# RESEND_FROM=DSE Gateway <alerts@your-domain.com>
# ARKESEL_API_KEY=
# ARKESEL_SENDER=DSE
# INGEST_SECRET=
# The station collector posts to https://<deployment>.convex.site/ncu/ingest
# with Authorization: Bearer $INGEST_SECRET. Set the same value in the collector
# environment. Do not put it in a VITE_ variable.
# NCU_KEY is the 32-hex uplink AES key. It stays on the gateway and the collector.
# Web push is not implemented. This repo has no VAPID keys and no web-push sender.
# Do not put a VAPID private key in a VITE_ variable.