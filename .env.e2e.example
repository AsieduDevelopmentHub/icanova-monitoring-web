# Playwright / browser E2E — copy to .env.e2e locally. Never commit real credentials.
# Unsigned smoke (default):
E2E_BASE_URL=http://127.0.0.1:4173
E2E_OIDC=0

# Authenticated staging (after real IdP + SPA build with VITE_OIDC_* + staging VITE_CONVEX_URL):
# E2E_OIDC=1
# E2E_BASE_URL=http://127.0.0.1:4173
# Optional cross-tenant check (synthetic foreign organization id on staging):
# E2E_FOREIGN_ORG_ID=
